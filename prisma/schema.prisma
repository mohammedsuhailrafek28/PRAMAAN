generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  MSME
  BUYER
  BANK
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  FLAGGED
}

enum EvidenceStatus {
  SELF_DECLARED
  DOCUMENT_SUBMITTED
  CROSS_CHECKED
  SOURCE_VERIFIED
  REJECTED
  EXPIRED
}

enum ReadinessLevel {
  NOT_READY
  EARLY_STAGE
  PARTIALLY_READY
  MOSTLY_READY
  READY_FOR_REVIEW
  BLOCKED
}

enum ReportType {
  BUSINESS_TRUST_PROFILE
  VENDOR_ONBOARDING_READINESS
  LOAN_APPLICATION_PREPARATION
  GOVERNMENT_PROCUREMENT_READINESS
  GOVERNMENT_SCHEME_APPLICATION_READINESS
}

enum DocumentType {
  GST_CERTIFICATE
  UDYAM_CERTIFICATE
  BANK_STATEMENT
}

enum OnboardingAssignmentStatus {
  REQUESTED
  ACCEPTED
  DECLINED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
}

enum ConsentStatus {
  PENDING
  APPROVED
  REJECTED
  REVOKED
  EXPIRED
}

enum AuditAction {
  REQUESTED
  APPROVED
  REJECTED
  VIEWED
  REVOKED
  EXPIRED
  PASSPORT_GENERATED
  BUSINESS_VERIFIED
  BUSINESS_PROFILE_CREATED
  BUSINESS_PROFILE_UPDATED
  DOCUMENT_SUBMITTED
  BUSINESS_CROSS_CHECKED
  EVIDENCE_GAP_FOUND
  CONTRADICTION_FOUND
  TRUST_PROFILE_GENERATED
  CONSENT_REQUESTED
  CONSENT_APPROVED
  TRUST_PROFILE_VIEWED
  CONSENT_REVOKED
  READINESS_PROFILE_EVALUATED
  READINESS_PROFILE_BLOCKED
  READINESS_PROFILE_SHARED
  REPORT_GENERATED
  REPORT_REVOKED
  REPORT_HTML_VIEWED
  REPORT_HTML_DOWNLOADED
  REPORT_PDF_DOWNLOADED
  ACCESS_GRANT_CREATED
  ACCESS_GRANT_VIEWED
  ACCESS_GRANT_REVOKED
  ACCESS_GRANT_EXPIRED
  CONSENT_REJECTED
  CONSENT_EXPIRED
  TRUST_VIEW_OPENED
  GUEST_LINK_CREATED
  GUEST_LINK_OPENED
  GUEST_LINK_REVOKED
  GUEST_LINK_EXPIRED
  EVIDENCE_UPLOADED
  EVIDENCE_REPLACED
  ONBOARDING_PACK_ASSIGNED
  ONBOARDING_PACK_ACCEPTED
  ONBOARDING_PACK_DECLINED
  ONBOARDING_PACK_CANCELLED
  ONBOARDING_PACK_COMPLETED
}

enum AccessGrantStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

model User {
  id               String           @id @default(cuid())
  role             UserRole
  name             String
  organizationName String
  email            String           @unique
  passwordHash     String
  createdAt        DateTime         @default(now())
  business         Business?
  consentRequests  ConsentRequest[] @relation("RequesterConsents")
  auditLogs        AuditLog[]        @relation("ActorAuditLogs")
  notifications    Notification[]
  generatedReports GeneratedReport[] @relation("ReportCreator")
  accessGrantsCreated AccessGrant[] @relation("GrantCreator")
  accessGrantsRequested AccessGrant[] @relation("GrantRequester")
  onboardingAssignmentsRequested OnboardingPackAssignment[] @relation("OnboardingRequester")
  requesterAssurance RequesterAssurance?
  requesterAssuranceEvents RequesterAssuranceEvent[]
  evidenceRequestsRequested EvidenceRequest[] @relation("EvidenceRequestRequester")
  evidenceRequestResponses EvidenceRequestResponse[] @relation("EvidenceResponseActor")
  evidenceRequestEvents EvidenceRequestEvent[] @relation("EvidenceEventActor")
}

model RequesterAssurance {
  id                       String   @id @default(cuid())
  userId                   String   @unique
  status                   String   @default("UNVERIFIED")
  reviewedOrganizationName String?
  reviewBasis              String?
  reviewedAt               DateTime?
  reviewerIdentifier       String?
  authorizationBasis      String?
  authorizationReference  String?
  authorizationScope      Json?
  authorizationExpiresAt  DateTime?
  suspensionReason         String?
  suspendedAt              DateTime?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  user                     User     @relation(fields: [userId], references: [id])
  @@index([status, authorizationExpiresAt])
}

model RequesterAssuranceEvent {
  id             String   @id @default(cuid())
  userId         String
  operatorId     String
  action         String
  previousStatus String
  newStatus      String
  metadata       Json?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model Business {
  id                 String             @id @default(cuid())
  userId             String             @unique
  legalName          String?
  gstin              String?            @unique
  udyamNumber        String?
  pan                String?
  address            String?
  turnoverBand       String?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  trustStatus        EvidenceStatus     @default(SELF_DECLARED)
  trustSummary       Json?
  lastCrossCheckedAt DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  user               User               @relation(fields: [userId], references: [id])
  documents          Document[]
  passports          Passport[]
  consentRequests    ConsentRequest[]
  auditLogs          AuditLog[]
  readinessEvaluations ReadinessEvaluation[]
  generatedReports   GeneratedReport[]
  accessGrants       AccessGrant[]
  onboardingAssignments OnboardingPackAssignment[]
  evidenceRequests EvidenceRequest[]
}

model Document {
  id           String       @id @default(cuid())
  businessId   String
  docType      DocumentType
  filePath     String
  originalName String
  mimeType     String
  verifiedFlag Boolean      @default(false)
  evidenceStatus EvidenceStatus @default(DOCUMENT_SUBMITTED)
  confidence     Int            @default(0)
  confidenceReason String?
  crossCheckMethod String?
  source          String?
  issuedAt        DateTime?
  checkedAt       DateTime?
  expiresAt       DateTime?
  revision        Int            @default(1)
  isCurrent       Boolean        @default(true)
  previousVersionId String?
  contradictionDetails Json?
  uploadedAt   DateTime     @default(now())
  business     Business     @relation(fields: [businessId], references: [id])
  previousVersion Document? @relation("DocumentRevisions", fields: [previousVersionId], references: [id])
  nextVersions   Document[] @relation("DocumentRevisions")
  evidenceRequestResponses EvidenceRequestResponse[]

  @@index([businessId, docType, isCurrent])
  @@index([previousVersionId])
  @@unique([businessId, docType, revision])
}

model Passport {
  id           String   @id @default(cuid())
  businessId   String
  version      Int
  snapshotJson Json
  generatedAt  DateTime @default(now())
  business     Business @relation(fields: [businessId], references: [id])
  consentApprovals ConsentRequest[] @relation("ConsentApprovedPassport")
  accessGrants AccessGrant[] @relation("GrantPassport")

  @@unique([businessId, version])
}

model ConsentRequest {
  id              String          @id @default(cuid())
  requesterId     String
  businessId      String
  requestedFields Json
  requestedEvidenceTypes Json @default("[]")
  purpose         String?
  approvedFields  Json?
  approvedEvidenceTypes Json @default("[]")
  approvedPassportId String?
  status          ConsentStatus   @default(PENDING)
  durationDays    Int?
  approvedAt      DateTime?
  expiresAt       DateTime?
  revokedAt       DateTime?
  createdAt       DateTime        @default(now())
  requester       User            @relation("RequesterConsents", fields: [requesterId], references: [id])
  business        Business        @relation(fields: [businessId], references: [id])
  approvedPassport Passport? @relation("ConsentApprovedPassport", fields: [approvedPassportId], references: [id])
  auditLogs       AuditLog[]
  notifications   Notification[]
}

model OnboardingPackAssignment {
  id                  String   @id @default(cuid())
  businessId          String
  requesterId         String
  packKey             String
  packVersion         String
  activeKey           String?  @unique
  requirementsSnapshot Json
  purpose             String
  status              OnboardingAssignmentStatus @default(REQUESTED)
  createdAt           DateTime @default(now())
  acceptedAt          DateTime?
  declinedAt          DateTime?
  cancelledAt         DateTime?
  completedAt         DateTime?
  business            Business @relation(fields: [businessId], references: [id])
  requester           User @relation("OnboardingRequester", fields: [requesterId], references: [id])
  auditLogs           AuditLog[]
  notifications       Notification[]
  evidenceRequests EvidenceRequest[]

  @@index([businessId, status, createdAt])
  @@index([requesterId, status, createdAt])
  @@index([packKey, packVersion])
}

model EvidenceRequest {
  id                   String   @id @default(cuid())
  assignmentId         String
  businessId           String
  requesterId          String
  requirementKey       String
  requirementSnapshot  Json
  requestKind          String
  reason               String
  status               String   @default("OPEN")
  activeKey            String?  @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  assignment           OnboardingPackAssignment @relation(fields: [assignmentId], references: [id])
  business             Business @relation(fields: [businessId], references: [id])
  requester            User @relation("EvidenceRequestRequester", fields: [requesterId], references: [id])
  responses            EvidenceRequestResponse[]
  events               EvidenceRequestEvent[]

  @@index([assignmentId, status, createdAt])
  @@index([businessId, status, createdAt])
  @@index([requesterId, status, createdAt])
}

model EvidenceRequestResponse {
  id                String   @id @default(cuid())
  requestId         String
  responderId       String
  responseType      String
  documentId        String?
  clarificationText String?
  createdAt         DateTime @default(now())
  request           EvidenceRequest @relation(fields: [requestId], references: [id])
  responder         User @relation("EvidenceResponseActor", fields: [responderId], references: [id])
  document          Document? @relation(fields: [documentId], references: [id])

  @@index([requestId, createdAt])
  @@index([documentId])
}

model EvidenceRequestEvent {
  id         String   @id @default(cuid())
  requestId  String
  actorId    String
  action     String
  fromStatus String?
  toStatus   String
  metadata   Json?
  createdAt  DateTime @default(now())
  request    EvidenceRequest @relation(fields: [requestId], references: [id])
  actor      User @relation("EvidenceEventActor", fields: [actorId], references: [id])

  @@index([requestId, createdAt])
}

model AccessGrant {
  id                    String           @id @default(cuid())
  businessId            String
  createdByUserId       String
  requesterId           String?
  recipientName         String?
  recipientOrganization String?
  recipientEmail        String?
  purpose               String
  scopeJson             Json
  passportId            String?
  tokenHash             String           @unique
  status                AccessGrantStatus @default(ACTIVE)
  createdAt             DateTime         @default(now())
  expiresAt             DateTime
  revokedAt             DateTime?
  lastAccessedAt        DateTime?
  business              Business         @relation(fields: [businessId], references: [id])
  createdBy             User             @relation("GrantCreator", fields: [createdByUserId], references: [id])
  requester             User?            @relation("GrantRequester", fields: [requesterId], references: [id])
  passport              Passport?        @relation("GrantPassport", fields: [passportId], references: [id])
  auditLogs             AuditLog[]

  @@index([businessId, createdAt])
  @@index([status, expiresAt])
}

model AuditLog {
  id               String          @id @default(cuid())
  businessId       String
  consentRequestId String?
  accessGrantId    String?
  onboardingAssignmentId String?
  actorId          String
  action           AuditAction
  metadata         Json?
  createdAt        DateTime        @default(now())
  business         Business        @relation(fields: [businessId], references: [id])
  consentRequest   ConsentRequest? @relation(fields: [consentRequestId], references: [id])
  accessGrant      AccessGrant? @relation(fields: [accessGrantId], references: [id])
  onboardingAssignment OnboardingPackAssignment? @relation(fields: [onboardingAssignmentId], references: [id])
  actor            User            @relation("ActorAuditLogs", fields: [actorId], references: [id])
}

model Notification {
  id               String          @id @default(cuid())
  userId           String
  message          String
  readFlag         Boolean         @default(false)
  relatedConsentId String?
  relatedOnboardingAssignmentId String?
  createdAt        DateTime        @default(now())
  user             User            @relation(fields: [userId], references: [id])
  relatedConsent   ConsentRequest? @relation(fields: [relatedConsentId], references: [id])
  relatedOnboardingAssignment OnboardingPackAssignment? @relation(fields: [relatedOnboardingAssignmentId], references: [id])
}

model ReadinessEvaluation {
  id             String         @id @default(cuid())
  businessId     String
  profileId      String
  profileVersion String
  score          Int
  level          ReadinessLevel
  blocked        Boolean
  summaryJson    Json
  evaluatedAt    DateTime       @default(now())
  business       Business       @relation(fields: [businessId], references: [id])
}

model GeneratedReport {
  id                    String     @id @default(cuid())
  businessId            String
  reportType            ReportType
  reportVersion         String
  trustProfileId        String?
  readinessEvaluationId String?
  snapshotJson          Json
  generatedAt           DateTime   @default(now())
  expiresAt             DateTime?
  revokedAt             DateTime?
  createdByUserId       String
  business              Business   @relation(fields: [businessId], references: [id])
  createdBy             User       @relation("ReportCreator", fields: [createdByUserId], references: [id])

  @@index([businessId, generatedAt])
  @@index([reportType])
  @@index([readinessEvaluationId])
}

/// Metadata of an owner evidence-review job. No extracted content is stored; no relation to consent/Passport/trust models.
model EvidenceReviewJob {
  id              String    @id @default(cuid())
  businessId      String
  userId          String
  status          String
  fingerprint     String
  docsTotal       Int       @default(0)
  docsDone        Int       @default(0)
  currentStep     String?
  errorCode       String?
  degraded        Boolean   @default(false)
  isolation       String?
  createdAt       DateTime  @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?
  heartbeatAt     DateTime?

  @@index([businessId, createdAt])
  @@index([status, createdAt])
}
